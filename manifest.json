{
  "manifest_version": 3,
  "name": "Cookie Manager",
  "version": "1.1",
  "description": "Manage website Cookies - Supports add, edit, delete, and clear functions.",
  "permissions": ["activeTab", "cookies"],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Manager"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "public/icon.png",
    "48": "public/icon.png",
    "128": "public/icon.png"
  }
}
